{
  "name": "ax-agent-observatory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "paperclip:install": "node experiments/paperclip/lab.mjs install",
    "paperclip:start": "node experiments/paperclip/lab.mjs start",
    "paperclip:seed": "node experiments/paperclip/lab.mjs seed",
    "paperclip:run": "node experiments/paperclip/lab.mjs run",
    "paperclip:status": "node experiments/paperclip/lab.mjs status",
    "paperclip:ax:seed": "node experiments/paperclip/ax-controller.mjs seed",
    "paperclip:ax:run": "node experiments/paperclip/ax-controller.mjs run",
    "paperclip:ax:status": "node experiments/paperclip/ax-controller.mjs status",
    "paperclip:ax:apply": "node experiments/paperclip/ax-controller.mjs apply",
    "paperclip:ax:serve": "node experiments/paperclip/ax-controller.mjs serve",
    "test:browser": "node tests/agent-filter.browser.mjs && node experiments/paperclip/verify-agent-navigation.mjs",
    "ifpmic:plugin:build": "node scripts/build-ifpmic-plugin.mjs",
    "test:ifpmic:browser": "node tests/ifpmic.browser.mjs",
    "ifpmic:lab:start": "node scripts/ifpmic-lab.mjs",
    "ifpmic:verify-sources": "node tests/ifpmic-source-upload.mjs",
    "test:ifpmic:host": "node tests/ifpmic-host.browser.mjs",
    "ifpmic:verify:v1": "node scripts/verify-ifpmic-v1.mjs",
    "test:ifpmic:replay": "node tests/ifpmic-replay.browser.mjs",
    "test:ifpmic:replay:host": "node tests/ifpmic-replay.browser.mjs --host",
    "ifpmic:catalog:evidence": "node scripts/ifpmic-catalog-evidence.mjs",
    "ifpmic:verify:ui": "node scripts/verify-ifpmic-ui.mjs",
    "ifpmic:profile": "node scripts/ifpmic-profile.mjs",
    "ifpmic:verify:profiles": "node scripts/verify-ifpmic-profiles.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
