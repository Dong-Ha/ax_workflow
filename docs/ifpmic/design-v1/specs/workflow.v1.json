  "route_rules": {
    "NEW_HW": "All original nodes execute; existing environment reuse allowed only with same validated profile.",
    "FEATURE": "Impact analysis selects document updates; no silent skip of quality or device checks.",
    "BUGFIX": "Reuse valid specification/design/environment baselines; default code-changing pilot executes all quality and device gates.",
    "REUSE": "Current inputs equal baseline or human confirms reuse; record artifact hash, reason, actor and plan_version. Node is SKIPPED with baseline evidence, not SUCCEEDED.",
    "POLICY": "Only explicit preapproved project rule plus human plan confirmation can exempt; default no exemption for pilot.",
    "COUPLED": "A measurement gate can only be exempt with its paired execution and recorded exemption. Exempt != PASS.",
    "loop_override": "Business failure forces execution from its target on the new cycle; prior skip decisions cannot bypass the failed gate or required human design reconsideration.",
