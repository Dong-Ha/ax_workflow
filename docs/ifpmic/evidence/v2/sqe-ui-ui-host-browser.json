      "details": {
        "routePath": "/IFP/ifpmic-ax",
        "setupWrites": 0
      }
    },
    {
      "name": "design view is the default and replay view requires explicit selection",
      "verdict": "pass"
    },
    {
      "name": "catalog exposes all 50 frozen scenarios and starts each at cursor zero",
      "verdict": "pass"
    },
    {
      "name": "all 50 scenarios reach their fixed endpoint through the end-observation control",
      "verdict": "pass"
    },
    {
      "name": "routing scenarios expose reuse, exemption, terminal, candidate and replan authority checkpoints",
      "verdict": "pass"
    },
    {
      "name": "scenario change clears display filters and resets selection and cursor",
      "verdict": "pass"
    },
    {
      "name": "previous/next/first/last and checkpoint selection move stored prefixes only",
      "verdict": "pass"
    },
    {
      "name": "observation panel separates mock job, step, agent and gate data and opens current node",
      "verdict": "pass"
    },
    {
      "name": "metadata recovery and notes checkpoints keep current approval and publication observability",
      "verdict": "pass"
    },
    {
      "name": "retry, cycle and device telemetry are distinct and never expose allocatable authority",
      "verdict": "pass"
    },
    {
      "name": "current-stage navigation reveals, focuses and scrolls a node hidden by active filters",
      "verdict": "pass"
    },
    {
      "name": "question panels distinguish durable answer, current-attempt review and archived review history",
      "verdict": "pass"
    },
    {
      "name": "remote panel shows stale-query rejection, one found receipt and quarantine independently",
      "verdict": "pass"
    },
    {
      "name": "SQE manual, report and judgment checkpoints remain separate across retries and history",
      "verdict": "pass"
    },
    {
      "name": "question review-blocked checkpoint remains legible at 1440px and 375px",
      "verdict": "pass"
    },
    {
      "name": "1440px and 375px layouts expose replay controls and details without horizontal page overflow",
      "verdict": "pass"
    },
    {
      "name": "browser replay makes no API writes, external requests or runtime errors",
      "verdict": "pass"
    }
